    {
      "line": 422,
      "colors": [
        "#94A3B8"
      ],
      "content": "<div style=\"font-size:12px;color:#94A3B8;\">Browse public rooms or join private rooms with password</div>"
    },
    {
      "line": 429,
      "colors": [
        "#0F172A",
        "#334155",
        "#FFF"
      ],
      "content": "<input type=\"text\" id=\"chat-room-search-input\" placeholder=\"Search rooms...\" style=\"flex:1;background:#0F172A;border:1px solid #334155;color:#FFF;padding:8px 12px;border-radius:8px;font-size:13px;\" />"
    },
    {
      "line": 430,
      "colors": [
        "#0284C7",
        "#38BDF8"
      ],
      "content": "<button class=\"btn btn-accent\" onclick=\"ChatApp.openCreateRoomModal()\" style=\"background:#0284C7;border-color:#38BDF8;white-space:nowrap;font-weight:700;\">＋ Create Room</button>"
    },
    {
      "line": 445,
      "colors": [
        "#FFF"
      ],
      "content": "<div style=\"font-weight:800;font-size:17px;color:#FFF;\">✨ Create a Chat Room</div>"
    },
    {
      "line": 452,
      "colors": [
        "#94A3B8"
      ],
      "content": "<label style=\"display:block;font-size:11px;font-weight:700;color:#94A3B8;margin-bottom:4px;text-transform:uppercase;\">Room Name *</label>"
    },
    {
      "line": 453,
      "colors": [
        "#0F172A",
        "#334155",
        "#FFF"
      ],
      "content": "<input type=\"text\" id=\"new-room-name-input\" required maxlength=\"30\" placeholder=\"e.g. Anime Club, Chill Lounge, Homework\" style=\"width:100%;background:#0F172A;border:1px solid #334155;color:#FFF;padding:8px 12px;border-radius:8px;font-size:13px;\" />"
    },
    {
      "line": 457,
      "colors": [
        "#94A3B8"
      ],
      "content": "<label style=\"display:block;font-size:11px;font-weight:700;color:#94A3B8;margin-bottom:4px;text-transform:uppercase;\">Topic / Description (Optional)</label>"
    },
    {
      "line": 458,
      "colors": [
        "#0F172A",
        "#334155",
        "#FFF"
      ],
      "content": "<input type=\"text\" id=\"new-room-desc-input\" maxlength=\"70\" placeholder=\"What is this room about?\" style=\"width:100%;background:#0F172A;border:1px solid #334155;color:#FFF;padding:8px 12px;border-radius:8px;font-size:13px;\" />"
    },
    {
      "line": 461,
      "colors": [
        "#0B132B",
        "#1E293B"
      ],
      "content": "<div style=\"background:#0B132B;border:1px solid #1E293B;padding:12px;border-radius:10px;\">"
    },
    {
      "line": 463,
      "colors": [
        "#E2E8F0"
      ],
      "content": "<label for=\"new-room-is-protected\" style=\"font-size:13px;font-weight:700;color:#E2E8F0;cursor:pointer;display:flex;align-items:center;gap:6px;\">"
    },
    {
      "line": 468,
      "colors": [
        "#64748B"
      ],
      "content": "<div style=\"font-size:11px;color:#64748B;\">Only people with the password can enter. As the creator, you can kick or ban users.</div>"
    },
    {
      "line": 471,
      "colors": [
        "#0F172A",
        "#38BDF8",
        "#FFF"
      ],
      "content": "<input type=\"password\" id=\"new-room-password-input\" placeholder=\"Set room password...\" style=\"width:100%;background:#0F172A;border:1px solid #38BDF8;color:#FFF;padding:8px 12px;border-radius:8px;font-size:13px;\" />"
    },
    {
      "line": 477,
      "colors": [
        "#0284C7",
        "#38BDF8"
      ],
      "content": "<button type=\"submit\" class=\"btn btn-accent\" style=\"background:#0284C7;border-color:#38BDF8;font-weight:800;\">Create & Enter 🚀</button>"
    },
    {
      "line": 490,
      "colors": [
        "#FFF"
      ],
      "content": "<div style=\"font-weight:800;font-size:16px;color:#FFF;display:flex;align-items:center;gap:6px;\">"
    },
    {
      "line": 495,
      "colors": [
        "#94A3B8"
      ],
      "content": "<p style=\"font-size:13px;color:#94A3B8;margin-bottom:12px;\" id=\"chat-pwd-modal-text\">This room requires a password to enter:</p>"
    },
    {
      "line": 498,
      "colors": [
        "#0F172A",
        "#334155",
        "#FFF"
      ],
      "content": "<input type=\"password\" id=\"chat-join-password-input\" required placeholder=\"Enter password...\" style=\"width:100%;background:#0F172A;border:1px solid #334155;color:#FFF;padding:9px 12px;border-radius:8px;font-size:13px;margin-bottom:8px;\" />"
    },
    {
      "line": 499,
      "colors": [
        "#EF4444"
      ],
      "content": "<div id=\"chat-password-error\" style=\"display:none;color:#EF4444;font-size:12px;margin-bottom:10px;\">Incorrect password. Please try again.</div>"
    },
    {
      "line": 503,
      "colors": [
        "#0284C7",
        "#38BDF8"
      ],
      "content": "<button type=\"submit\" class=\"btn btn-accent\" style=\"background:#0284C7;border-color:#38BDF8;font-weight:800;\">Unlock & Join 🔓</button>"
    },
    {
      "line": 516,
      "colors": [
        "#FFF"
      ],
      "content": "<div style=\"font-weight:800;font-size:16px;color:#FFF;display:flex;align-items:center;gap:6px;\">"
    },
    {
      "line": 519,
      "colors": [
        "#94A3B8"
      ],
      "content": "<div style=\"font-size:11px;color:#94A3B8;\" id=\"chat-members-modal-subtitle\">Active participants in this room</div>"
    },
    {
      "line": 524,
      "colors": [
        "#94A3B8"
      ],
      "content": "<div style=\"font-size:11px;font-weight:700;color:#94A3B8;text-transform:uppercase;margin-bottom:8px;\">Active Now</div>"
