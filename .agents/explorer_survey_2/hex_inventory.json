  "app.js": [
    {
      "line": 218,
      "colors": [
        "#202432",
        "#DD53B4"
      ],
      "content": "<span style=\"background:#202432;color:#DD53B4;padding:3px 6px;border-radius:4px;font-size:11px;font-weight:800;min-width:44px;text-align:center;\">${ch.isLocal ? 'OFFLINE' : '#' + ch.number}</span>"
    },
    {
      "line": 219,
      "colors": [
        "#FFF"
      ],
      "content": "<span style=\"font-size:12px;font-weight:600;color:#FFF;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\" title=\"${ch.title}\">${ch.title}</span>"
    },
    {
      "line": 454,
      "colors": [
        "#141722",
        "#232736"
      ],
      "content": "<div style=\"background:#141722;border:1px solid #232736;border-radius:8px;padding:14px;display:flex;flex-direction:column;gap:8px;\">"
    },
    {
      "line": 456,
      "colors": [
        "#202432",
        "#DD53B4"
      ],
      "content": "<span style=\"background:#202432;color:#DD53B4;padding:2px 8px;border-radius:4px;font-weight:bold;font-size:11px;\">#${b.chapterNumber}</span>"
    },
    {
      "line": 457,
      "colors": [
        "#8B94A7"
      ],
      "content": "<span style=\"font-size:11px;color:#8B94A7;\">${new Date(b.timestamp).toLocaleDateString()}</span>"
    },
    {
      "line": 460,
      "colors": [
        "#8B94A7"
      ],
      "content": "<div style=\"font-size:12px;color:#8B94A7;\">Page ${b.pageIndex + 1}</div>"
    },
    {
      "line": 463,
      "colors": [
        "#FF6B6B"
      ],
      "content": "<button class=\"btn\" style=\"color:#FF6B6B;\" onclick=\"deleteBookmark(${idx})\">🗑️ Delete</button>"
    },
    {
      "line": 554,
      "colors": [
        "#1A1E29"
      ],
      "content": "<div style=\"display:grid;grid-template-columns:40px 70px 1fr 200px 100px;align-items:center;padding:8px 14px;border-bottom:1px solid #1A1E29;font-size:13px;\">"
    },
    {
      "line": 556,
      "colors": [
        "#202432",
        "#DD53B4"
      ],
      "content": "<span style=\"background:#202432;color:#DD53B4;padding:2px 6px;border-radius:4px;font-size:11px;font-weight:bold;text-align:center;\">#${ch.number}</span>"
    },
    {
      "line": 558,
      "colors": [
        "#242836"
      ],
      "content": "<div style=\"height:6px;background:#242836;border-radius:3px;overflow:hidden;\">"
    },
    {
      "line": 559,
      "colors": [
        "#DD53B4"
      ],
      "content": "<div id=\"prog-${ch.number}\" style=\"height:100%;background:#DD53B4;width:0%;\"></div>"
    },
